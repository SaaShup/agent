{
  "name": "paashup-agent",
  "version": "2.3.0",
  "description": "Management agent for PaasHup",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "HTTP_SECURE=true npm run build:all",
    "build:light": "docker compose -f docker-compose.yml up -d --build",
    "build:ssh": "node scripts/check-ssh-file.mjs && docker compose -f docker-compose.yml -f docker-compose.ssh.yml up -d --build",
    "build:quota": "docker compose -f docker-compose.yml -f docker-compose.quotas.yml up -d --build",
    "start": "node src/index.js",
    "test": "bash tests/run.sh",
    "test:unit": "node --test --experimental-test-coverage --test-coverage-include='src/**/*.js' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 tests/unit/*.test.js tests/integration/*.test.js",
    "codeql:install": "bash scripts/install-codeql.sh",
    "test:codeql": "bash tests/codeql/run.sh",
    "test:hurl": "bash tests/hurl/run.sh",
    "test:compat": "bash tests/compat/run.sh",
    "test:browser": "bash tests/e2e/run.sh",
    "test:quota": "node --test tests/host/volume-quotas.test.js",
    "build:all": "node scripts/check-ssh-file.mjs && docker compose -f docker-compose.yml -f docker-compose.ssh.yml -f docker-compose.quotas.yml up -d --build"
  },
  "license": "ISC",
  "dependencies": {
    "@xterm/xterm": "6.0.0",
    "bcryptjs": "3.0.3",
    "dockerode": "5.0.1",
    "swagger-ui-dist": "5.33.3",
    "ws": "8.22.0"
  }
}
